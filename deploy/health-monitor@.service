# systemd --user template: health-monitor@monitor, @manager, @web
# Installed by `make install-units`; @CHECKOUT@ is filled in from the
# checkout it was run in.  Survives logout only after
#   sudo loginctl enable-linger <user>
[Unit]
Description=health-monitor %i
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=@CHECKOUT@
Environment=PYTHONPATH=@CHECKOUT@
Environment=PYTHONUNBUFFERED=1
ExecStart=@CHECKOUT@/.venvhealth/bin/python -m health_monitor %i
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=default.target
